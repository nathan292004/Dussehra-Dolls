# Chit cancellation service (internal — only the main API calls it; never expose it publicly).
DATABASE_URL=postgresql://user:password@localhost:5432/dolldime

# Must be the SAME value as CHIT_SERVICE_TOKEN in artifacts/api-server/.env (32+ random chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHIT_SERVICE_TOKEN=

CHIT_SERVICE_PORT=3002
# Listens on 127.0.0.1 by default. In production set this to the private-network address the API
# can reach (never 0.0.0.0 on a public machine).
# CHIT_SERVICE_HOST=127.0.0.1
NODE_ENV=development
