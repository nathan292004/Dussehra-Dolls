# ─── Required ─────────────────────────────────
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/dolldime

# ─── Razorpay ─────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ─── Twilio (SMS + WhatsApp) ──────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Alternatively use an API key and secret (Account SID is still required).
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Sender must belong to this Twilio account and support SMS; not a recipient number.
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_WHATSAPP_FROM=+14155238886

# ─── Optional ─────────────────────────────────
NODE_ENV=development
WHATSAPP_TEST_NUMBER=+91xxxxxxxxxx
