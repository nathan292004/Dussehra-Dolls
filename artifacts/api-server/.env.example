# ─── Required ─────────────────────────────────
PORT=3001
DATABASE_URL=postgresql://user:password@localhost:5432/dolldime

# --- Login secrets ---------------------------
# Each is a long random string (32+ chars), different from the other. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Signs customer app logins (JWT):
JWT_SECRET=

# Signs admin website logins (JWT):
ADMIN_TOKEN_SECRET=

# ─── Razorpay ─────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Secret for the payment.captured webhook (Razorpay Dashboard -> Settings -> Webhooks).
RAZORPAY_WEBHOOK_SECRET=
# Set to true only after Razorpay has enabled partial payments on your account;
# lets a customer pay part of an amount due (we then message them the remainder).
RAZORPAY_ALLOW_PARTIAL_PAYMENTS=false

# ─── Twilio (registration SMS only) ──────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Alternatively use an API key and secret (Account SID is still required).
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=your_twilio_api_key_secret
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Sender must belong to this Twilio account and support SMS; not a recipient number.
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ─── Meta WhatsApp Cloud API (direct) ────────
META_WHATSAPP_ACCESS_TOKEN=your_permanent_system_user_token
META_WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Used to verify the promotional template and show its exact text in admin.
META_WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
META_APP_SECRET=your_meta_app_secret
META_WHATSAPP_VERIFY_TOKEN=choose_a_long_random_webhook_verify_token
META_GRAPH_API_VERSION=v26.0
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US
META_WHATSAPP_ORDER_TEMPLATE_NAME=dolldime_order_confirmation
META_WHATSAPP_CHIT_TEMPLATE_NAME=dolldime_chit_payment
META_WHATSAPP_WALLET_TEMPLATE_NAME=dolldime_wallet_topup
META_WHATSAPP_REMINDER_TEMPLATE_NAME=dolldime_chit_reminder
META_WHATSAPP_PROMO_TEMPLATE_NAME=dolldime_offer

# ─── Background jobs ──────────────────────────
# Reminders and releasing abandoned checkouts. Locally the web server runs them itself (default).
# In production run ONE separate worker (`pnpm --filter @workspace/api-server run start:worker`)
# and set this to false on the web servers so scaling them up never means duplicate work.
RUN_BACKGROUND_JOBS=true

# ─── Optional ─────────────────────────────────
NODE_ENV=development
# Local-only OTP display for development, never enable in production.
DEV_OTP_MODE=false
AUTH_TOKEN_SECRET=replace_with_random_32_byte_secret
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace_with_strong_password
ADMIN_SESSION_SECRET=replace_with_another_random_32_byte_secret
CORS_ALLOWED_ORIGINS=https://admin.example.com
API_PUBLIC_ORIGIN=https://api.example.com
